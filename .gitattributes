# Auto detect text files and perform LF normalization
* text=auto

# Scripts must always use LF (Unix line endings)
*.sh text eol=lf
gradlew text eol=lf
.husky/* text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary

# Keep these files with LF even on Windows
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
